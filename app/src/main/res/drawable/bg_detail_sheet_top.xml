<?xml version="1.0" encoding="utf-8"?>
<!-- Strip with rounded top corners at the bottom of the hero: makes the content look like a sheet
     sliding over the cover, without negative margins -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:topLeftRadius="26dp" android:topRightRadius="26dp" />
    <solid android:color="@color/background" />
</shape>