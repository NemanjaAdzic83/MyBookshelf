<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- [ISPRAVKA M1] Uklonjeno READ_EXTERNAL_STORAGE i READ_MEDIA_IMAGES:
         ActivityResultContracts.GetContent koristi sistemski picker koji ne traži nikakvu
         dozvolu, a Google Play traži posebno obrazloženje za READ_MEDIA_IMAGES. -->

    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false"/>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PersonalLibrary"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity android:name=".activities.MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity android:name=".activities.AddBookActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"/>

        <activity android:name=".activities.BookDetailActivity"
            android:exported="false"/>

        <!-- [ISPRAVKA M2] stateVisible: tastatura se otvara sama, pa nije potreban postDelayed() hack u kodu -->
        <activity android:name=".activities.SearchActivity"
            android:exported="false"
            android:windowSoftInputMode="stateVisible|adjustResize"/>

        <activity android:name=".activities.BarcodeScannerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.PersonalLibrary.Scanner"/>
    </application>
</manifest>
